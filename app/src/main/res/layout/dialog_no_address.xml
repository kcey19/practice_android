<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="24dp" />

    <!-- Illustration -->
    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/map_placeholder"
        android:contentDescription="No Address"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No address added yet !"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have not added any shipping address."
        android:textSize="14sp"
        android:textColor="#8E8E93"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetAddress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SET ADDRESS"
        android:textColor="@android:color/white"
        app:backgroundTint="#2ABB00"
        app:cornerRadius="8dp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />


    <TextView
        android:id="@+id/btnCancelAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CANCEL"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#8E8E93"
        android:padding="8dp" />

</LinearLayout>