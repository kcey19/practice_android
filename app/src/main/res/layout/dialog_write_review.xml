<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_card"
    android:padding="24dp">

    <!-- Single Unified Dialog Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Write a Review"
        android:textSize="18sp"
        android:fontFamily="@font/source_sans_pro_semibold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="20dp" />

    <!-- Inner Input Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FAFAFA"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your overall rating"
            android:textSize="13sp"
            android:fontFamily="@font/source_sans_pro_semibold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <!-- Rating Stars (Starts at 0, turns Yellowish-Orange on selection) -->
        <RatingBar
            android:id="@+id/dialogRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="0.0"
            android:progressTint="#FFB800"
            android:progressBackgroundTint="#D1D1D6"
            android:secondaryProgressTint="#FFB800"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review"
            android:textSize="13sp"
            android:fontFamily="@font/source_sans_pro_semibold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/dialogEdtComment"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_rounded_card"
            android:hint="Write your review here..."
            android:gravity="top|start"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="@color/textPrimary"
            android:inputType="textMultiLine" />
    </LinearLayout>

    <!-- Custom Action Button -->
    <Button
        android:id="@+id/btnPublishFeedback"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SUBMIT REVIEW"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:backgroundTint="@color/primaryGreen" />

</LinearLayout>