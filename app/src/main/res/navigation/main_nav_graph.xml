<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.shardul.esewazone.ui.fragments.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment"/>
    </fragment>


    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.shardul.esewazone.ui.fragments.ProductDetailsFragment"
        android:label="Product Details">
        <argument
            android:name="productId"
            app:argType="integer"/>
        <action
            android:id="@+id/action_productDetailsFragment_to_cartHideFragment"
            app:destination="@+id/cartHideFragment"/>
    </fragment>
    <fragment
        android:id="@+id/cartFragment"
        android:name="com.shardul.esewazone.ui.fragments.CartFragment"
        android:label="Cart" />

    <fragment
        android:id="@+id/cartHideFragment"
        android:name="com.shardul.esewazone.ui.fragments.CartFragment"
        tools:layout="@layout/fragment_cart"/>
    <fragment
        android:id="@+id/favouritesFragment"
        android:name="com.shardul.esewazone.ui.fragments.FavouritesFragment"
        android:label="Favourites" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.shardul.esewazone.ui.fragments.ProfileFragment"
        android:label="Profile" />
</navigation>